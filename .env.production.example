# Plantilla de variables para producción. Cópiala en el gestor de secretos de la plataforma
# (no subas nunca un .env.production con valores reales). Ver README → Despliegue.

NODE_ENV=production
PORT=4000
# Dominio(s) del frontend publicado, separados por coma (sin barra final)
CORS_ORIGIN=https://knet.example.com
# Proxies delante de la API (1 detrás del balanceador de Render, Railway, Fly, Cloud Run…)
TRUST_PROXY=1

# PostgreSQL gestionado con SSL
DATABASE_URL=postgres://USUARIO:CLAVE@HOST:5432/knet?sslmode=require
# true = verifica el certificado; no-verify = cifra sin verificar (proveedores con certificado propio)
DATABASE_SSL=true
# Migraciones al arrancar el contenedor (false si las corre un job previo con npm run db:migrate)
RUN_MIGRATIONS=true
# Varias instancias de la API → reparte los eventos SSE con LISTEN/NOTIFY
EVENTS_PG_NOTIFY=false
SSE_HEARTBEAT_MS=25000

# Autenticación (#1)
JWT_SECRET=
JWT_TTL=15m
REFRESH_TTL=30d
AUTH_RATE_LIMIT=20
LEGAL_VERSION=1.2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.knet.example.com/api/auth/linkedin/callback

# IA (#2)
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=20000
AI_RATE_LIMIT=10

# ───── QR dinámico y check-in NFC ─────
# Secreto HMAC de los QR entre asistentes (vacío = se deriva de JWT_SECRET). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
QR_SECRET=
# Vida de cada token QR en segundos (10-300). El frontend lo renueva antes de que caduque.
QR_TTL_S=45
# Escaneos por usuario y por minuto en POST /api/me/connections/scan
QR_SCAN_RATE_LIMIT=30
CONN_REQUEST_RATE_LIMIT=20
# Credencial de los tótems NFC (header X-Totem-Key). Vacío fuera de desarrollo = endpoint desactivado (503).
TOTEM_SECRET=
