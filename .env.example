# Copia este archivo a .env (cp .env.example .env). Valores solo para desarrollo local.

# API
PORT=4000
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma (vite dev: 5173, vite preview: 4173)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Usuario que se usa cuando la petición no trae el header X-User-Id
DEMO_USER_EMAIL=demo.tech@knet.local

# PostgreSQL (docker-compose.yml lee estas variables)
POSTGRES_USER=knet
POSTGRES_PASSWORD=knet
POSTGRES_DB=knet
POSTGRES_PORT=5433

# Cadena de conexión que usa la API (puerto 5433 del host)
DATABASE_URL=postgres://knet:knet@localhost:5433/knet
