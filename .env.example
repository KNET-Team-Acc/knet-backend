# Copia este archivo a .env (cp .env.example .env). Valores solo para desarrollo local.

# API
PORT=4000
NODE_ENV=development
# Orígenes permitidos por CORS, separados por coma (vite dev: 5173, vite preview: 4173)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
# Solo con NODE_ENV=development: usuario que se usa cuando la petición no trae token ni X-User-Id
DEMO_USER_EMAIL=demo.tech@knet.local

# PostgreSQL (docker-compose.yml lee estas variables)
POSTGRES_USER=knet
POSTGRES_PASSWORD=knet
POSTGRES_DB=knet
POSTGRES_PORT=5433

# Cadena de conexión que usa la API (puerto 5433 del host)
DATABASE_URL=postgres://knet:knet@localhost:5433/knet

# ───── Autenticación ─────
# Secreto para firmar los JWT (obligatorio con NODE_ENV=production). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración del access token y del refresh token (s, m, h, d)
JWT_TTL=15m
REFRESH_TTL=30d
# Intentos por IP cada 15 min en /api/auth/login, /register y /exchange
AUTH_RATE_LIMIT=20
# Proxies delante de la API (0 en local; 1 detrás del balanceador de la plataforma)
TRUST_PROXY=0
# Versión vigente de Términos y Política: igual a LEGAL.version del frontend (src/data/config.js)
LEGAL_VERSION=1.2

# LinkedIn (OpenID Connect). Crea la app en https://www.linkedin.com/developers/ con el producto
# "Sign In with LinkedIn using OpenID Connect" y registra exactamente esta URL de redirección.
# Sin client id/secret, /api/auth/linkedin responde 503 y el frontend usa el formulario manual.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/auth/linkedin/callback

# ───── IA (Claude, SDK oficial @anthropic-ai/sdk) ─────
# Key de https://platform.claude.com/ (solo vive en el servidor; nunca se envía al frontend ni a los logs).
# Sin key, /api/ai/* responde 503 ai_unavailable y el frontend usa sus respuestas locales.
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# Tiempo máximo por intento (ms). Hay un solo reintento.
AI_TIMEOUT_MS=20000
# Peticiones a /api/ai/* por usuario y por minuto
AI_RATE_LIMIT=10
