{
  "name": "knet-backend",
  "private": true,
  "version": "1.0.0",
  "description": "KNET · API REST (Express 5) + PostgreSQL para el panel del asistente.",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:seed:demo": "node db/seed.js --demo",
    "db:reset": "node db/migrate.js --reset && node db/seed.js",
    "smoke": "node scripts/smoke.js",
    "test:linkedin": "node scripts/linkedin-mock.js",
    "test:ai": "node scripts/ai-mock.js",
    "test:stream": "node scripts/stream-test.js",
    "parity": "node scripts/agenda-parity.js",
    "parity:venues": "node scripts/venue-parity.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
